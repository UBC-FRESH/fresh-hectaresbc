# Copy to /etc/fresh-hectaresbc-demo.env and set local paths.
# Do not put cloud credentials or API keys here.
FRESH_HECTARESBC_ARCHIVE_ROOT=/srv/shared-data/gep/fresh-hectaresbc/hectaresbc
FRESH_HECTARESBC_FEMIC_SRC=/srv/shared-data/gep/ws4/femic/src
PORT=8030
FRESH_HECTARESBC_PUBLIC_URL=https://fresh-hectaresbc.01101.dev
FRESH_HECTARESBC_TILE_CACHE_MAX_BYTES=4294967296
FRESH_HECTARESBC_JOB_HISTORY_LIMIT=100
FRESH_HECTARESBC_JOB_HISTORY_MAX_AGE_DAYS=30
FRESH_HECTARESBC_BUNDLE_HISTORY_LIMIT=50
FRESH_HECTARESBC_BUNDLE_HISTORY_MAX_AGE_DAYS=30
FRESH_HECTARESBC_BUNDLE_AOI_MAX_AGE_DAYS=7
FRESH_HECTARESBC_BUNDLE_AOI_MAX_FILES=500
